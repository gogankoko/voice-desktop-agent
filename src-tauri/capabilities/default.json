{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal capability for the main window. App commands are registered in lib.rs; add plugin permissions here only when a feature needs them.",
  "windows": ["main"],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:window:default",
    "allow-get-app-status",
    "allow-get-preferences",
    "allow-set-preferences",
    "allow-get-speech-setup",
    "allow-save-azure-speech",
    "allow-clear-azure-speech",
    "allow-get-speech-token",
    "allow-speak-natural",
    "allow-get-assistant-setup",
    "allow-save-gemini-key",
    "allow-clear-gemini-key",
    "allow-run-agent",
    "allow-cancel-agent",
    "allow-pause-agent",
    "allow-resume-agent",
    "allow-confirm-agent",
    "allow-get-diagnostics",
    "allow-clear-diagnostics",
    "allow-log-frontend-error"
  ]
}
